# Tools are installed directly; no environment activation is required.
export EDITOR=nano
export KUBECONFIG="{{ script_dir }}/k8s/kube-config.yaml"
cd "{{ script_dir }}"
alias k=kubectl
alias kc='kubectl cnpg'
alias c=kubectx
alias n=kubens
alias bat=batcat
source <(kubectl completion bash)
complete -o default -F __start_kubectl k
source <(kubectl cnpg completion bash)
complete -o default -F __start_kubectl-cnpg kc
for completion in /usr/share/bash-completion/completions/kubectx /usr/share/bash-completion/completions/kubens; do
    [[ ! -f "$completion" ]] || source "$completion"
done
complete -F _kube_contexts c
complete -F _kube_namespaces n
if [[ $- == *i* ]]; then
    cat <<'CNPG_GREETING'

**********************************************************************
**                Welcome to the CloudNativePG Lab                  **
**                                                                  **
** ▣ Docker container  =  ⚙ Kubernetes node/server (KIND clusters)  **
**                                                                  **
**   ┌───────────────┐    ┌───────────────┐    ┌───────────────┐    **
**   │  Docker       │    │  Docker       │    │  Docker       │    **
**   │  Container    │    │  Container    │    │  Container    │    **
**   │  ┌─────────┐  │    │  ┌─────────┐  │    │               │    **
**   │  │  pod-1  │  │    │  │  pod-3  │  │    │ S3 API/Web UI │    **
**   │  └─────────┘  │    │  └─────────┘  │    │               │    **
**   │  ┌─────────┐  │    │  ┌─────────┐  │    │  {pg backup}  │    **
**   │  │  pod-2  │  │    │  │  pod-4  │  │    │               │    **
**   │  └─────────┘  │    │  └─────────┘  │    │ RustFS Object │    **
**   │  Kubernetes   │    │  Kubernetes   │    │ Storage       │    **
**   │  Node/Server  │    │  Node/Server  │    └───────────────┘    **
**   └───────────────┘    └───────────────┘                         **
**                                                                  **
** A few useful commands:           <hint: try TAB to autocomplete> **
**   bat - syntax-highlighted file viewer                           **
**   btop - show system utilization (cpu, io, network, procs, etc)  **
**   lazydocker - terminal UI for Docker: nodes/servers in this Lab **
**   k9s - terminal UI for Kubernetes                               **
**   k or kubectl - Kubernetes command line tool                    **
**   kc or kubectl cnpg - CNPG plugin for kubectl                   **
**   c or kubectx - switch between Kubernetes contexts              **
**   n or kubens - switch between Kubernetes namespaces             **
**                                                                  **
** scripts/setup.sh eu us                                           **
**                   creates k8s-eu and k8s-us Kubernetes clusters  **
** demo/setup.sh eu us                                              **
**                   creates pg-eu and pg-us CloudNativePG clusters **
** lab/render.sh       writes editable PostgreSQL cluster manifests **
**********************************************************************
CNPG_GREETING
fi
